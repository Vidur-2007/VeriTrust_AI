# Google Gemini (free tier) — get a key at https://aistudio.google.com
GEMINI_API_KEY=
# Flash-class chat model, e.g. from `client.models.list()`
GEMINI_MODEL=
# Tried in order when the model above is overloaded or out of its daily free quota
# (free tier: about 20 requests per model per day). Comma-separated.
GEMINI_MODEL_FALLBACKS=
# Thinking effort for Flash models: minimal | low | medium | high | off
GEMINI_THINKING=minimal
# Embedding model used for Chroma retrieval
GEMINI_EMBED_MODEL=
# Seconds before a Gemini call counts as a network failure (then Ollama takes over)
GEMINI_TIMEOUT_S=30

# Primary provider: gemini | ollama
LLM_PROVIDER=gemini
# Fall back to Ollama automatically on network errors or repeated 429s
LLM_FALLBACK=true
# Max LLM requests per minute for the primary provider (Gemini free tier is low)
LLM_RPM=10
# Max embedding requests per minute (separate Gemini quota)
EMBED_RPM=60

# Local Ollama fallback (Gemma)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=gemma3:4b
OLLAMA_EMBED_MODEL=nomic-embed-text

# Where SQLite, Chroma and the LLM cache live. Blank = backend/var
DATA_DIR=
